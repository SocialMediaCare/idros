# ============================================================
# IDROS — variabili d'ambiente
# Copiare in .env.local per lo sviluppo (`vercel dev`) e
# inserire gli stessi valori su Vercel → Settings → Environment
# Variables. Il repository è pubblico: .env* è in .gitignore
# e non deve MAI finire in un commit.
# ============================================================

# ---------- Supabase ----------
# Dashboard Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chiave pubblica: serve al login del pannello, può stare nel browser.
SUPABASE_ANON_KEY=eyJhbGciOi...

# Chiave segreta: scavalca ogni permesso. Solo lato server, mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- Chi può entrare nel pannello ----------
# Email abilitate, separate da virgola. Devono esistere anche come
# utenti in Supabase → Authentication → Users.
ADMIN_EMAILS=info@idrosmilanomarittima.it

# ---------- Email (Resend) ----------
# resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Mittente: il dominio va verificato su Resend, altrimenti l'invio fallisce.
MAIL_FROM=IDROS <info@idrosmilanomarittima.it>

# Casella del ristorante: riceve l'avviso di ogni nuova richiesta.
# Si possono elencare più indirizzi separati da virgola; la risposta
# dei clienti va al primo.
MAIL_OWNER=info@idrosmilanomarittima.it

# ---------- Sito ----------
# Senza barra finale. Usato nei link dentro le email.
SITE_URL=https://idrosmilanomarittima.it

# ---------- Sito in arrivo ----------
# Finché c'è, il pubblico vede in-arrivo.html e il sito vero si apre
# solo con /?anteprima=<PREVIEW_KEY> (vedi middleware.js).
# Per mettere online il sito: eliminarla su Vercel e rilanciare il deploy.
PREVIEW_KEY=una-chiave-a-caso
